%% -*- mode: erlang -*-
%% mcl-testkit. Composes macula-testkit's in-memory mesh into the mcl_om
%% identity, so an mcl-* service's real publish/subscribe path runs in process.
%%
%% Depends on mcl_om (the facade services call, and the module stubbed), meck
%% (to stub the identity), macula_testkit (the in-memory pools) and macula,
%% declared directly because the harness publishes and subscribes itself.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {meck, "~> 1.2"},
    %% The floor is 1.4.0, the mcl_om whose base library is macula 16. Left
    %% at `~> 1.0' it also admits 1.3.0, which requires macula `~> 15.6';
    %% rebar3 drops that conflict silently against the direct macula below
    %% (macula-codebase-checks#14).
    {mcl_om, "~> 1.4"},
    %% 0.3.0 is the release that answers wire 1.0's registration wait and
    %% group-keyring ask; 0.2.0 answers both with {error, unsupported}.
    {macula_testkit, "~> 0.3"},
    {macula, "~> 16.0"}
]}.

%% Every plugin pinned: the pin lives in this file, so it is inside the
%% release tag (rebar3_hex 7.3.0 stopped reading HEX_API_KEY).
{project_plugins, [
    {rebar3_hex, "~> 7.2.0"},
    {rebar3_ex_doc, "0.3.0"},
    {rebar3_lint, "6.0.0"}
]}.

{hex, [
    {doc, #{provider => ex_doc}}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/macula-services/mcl-testkit">>},
    {extras, ["README.md", "CHANGELOG.md", "LICENSE"]},
    {main, "README.md"}
]}.

{elvis, [
    {rulesets, #{
        macula_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}},
            {elvis_style, max_function_length, #{max_length => 60}}
        ]
    }},
    {config, [#{files => ["src/**/*.erl"], ruleset => macula_min}]}
]}.
